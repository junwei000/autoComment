{
  "manifest_version": 3,
  "name": "AutoComment",
  "version": "2.0.0",
  "description": "使用你自己的 OpenRouter Key，批量为博客文章生成并提交评论。",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AutoComment - 批量评论"
  },
  "options_page": "batch.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "illegal-site-filter.js",
        "lib/submission-waiter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
